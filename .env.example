# FixItNow — Root Environment Variables (Production & Staging Template)
# Copy to .env and supply actual deployment values

# Supabase PostgreSQL & Cloud Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Express Civic Backend Server
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://fixitnow-citizen.vercel.app,https://fixitnow-admin.vercel.app
CLIENT_URL=https://fixitnow-citizen.vercel.app
ADMIN_URL=https://fixitnow-admin.vercel.app
AI_SERVICE_URL=http://127.0.0.1:8000
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Pluggable SMS OTP Gateway Configuration (Optional for Live SMS Delivery)
SMS_PROVIDER=mock # Options: twilio | fast2sms | msg91 | mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI Model Inference Configuration (FROZEN V5 CHECKPOINT)
AI_EMBEDDING_DIMENSIONS=384
AI_CONFIDENCE_THRESHOLD=0.75
AI_DUPLICATE_THRESHOLD=0.80
